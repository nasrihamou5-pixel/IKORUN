#!/bin/sh
# ============================================================================
# IKORUN — garde-fou de commit
#
# Installation (une fois) :   git config core.hooksPath .githooks
# Ce fichier est la reference ; .githooks/pre-commit en est la copie active.
#
# Deux des trois failles critiques de l'audit du 07/09/2026 auraient ete
# attrapees ici. La plus couteuse : une variable supprimee sans ses usages,
# ReferenceError en production pendant une heure, toutes les seances muscu
# cassees.
#
# Sans Node, les verifications de syntaxe et d'i18n sont IMPOSSIBLES. Le hook
# le dit desormais franchement au lieu de passer en silence : un garde-fou
# muet qui ne verifie rien est pire que pas de garde-fou, on lui fait
# confiance a tort.
# ============================================================================
fail=0
node_absent=0

command -v node >/dev/null 2>&1 || node_absent=1

if [ "$node_absent" -eq 1 ]; then
  echo "----------------------------------------------------------------"
  echo " ATTENTION : Node.js absent."
  echo " La syntaxe de app.js/sw.js et la coherence des traductions"
  echo " NE SONT PAS verifiees. Ce commit part sans filet."
  echo " Installer Node : https://nodejs.org  (choix LTS)"
  echo "----------------------------------------------------------------"
fi

# --- 1. Syntaxe -------------------------------------------------------------
if [ "$node_absent" -eq 0 ]; then
  for f in app.js sw.js tests/smoke.js; do
    [ -f "$f" ] || continue
    node --check "$f" || { echo "ERREUR de syntaxe dans $f"; fail=1; }
  done
fi

# --- 2. Coherence des traductions ------------------------------------------
if [ "$node_absent" -eq 0 ] && [ -f app.js ]; then
  node -e '
    const src=require("fs").readFileSync("app.js","utf8");
    const m=src.match(/const I18N *= *\{[\s\S]*?\n\};/);
    if(!m){ console.log("i18n: bloc introuvable, verification ignoree"); process.exit(0); }
    let I18N; try{ I18N=eval("("+m[0].replace(/^const I18N *= */,"")+")"); }catch(e){ console.log("i18n: non evaluable, ignore"); process.exit(0); }
    const fr=Object.keys(I18N.fr||{});
    const manqEn=fr.filter(k=>!(k in (I18N.en||{})));
    const manqAr=fr.filter(k=>!(k in (I18N.ar||{})));
    if(manqEn.length||manqAr.length){
      console.log("ERREUR i18n - manquantes en EN:", manqEn.join(", ")||"(aucune)");
      console.log("ERREUR i18n - manquantes en AR:", manqAr.join(", ")||"(aucune)");
      process.exit(1);
    }
    console.log("i18n OK ("+fr.length+" cles x 3 langues)");
  ' || fail=1
fi

# --- 3. Boites de dialogue natives -----------------------------------------
# prompt(), confirm() et alert() ne s ouvrent PAS dans une PWA installee sur
# iOS. Quatre appels a prompt() y sont restes des mois : "creer un plan perso"
# et "modifier la bio" ne faisaient simplement rien sur iPhone.
# Ne necessite pas Node.
#
# Le retrait des commentaires doit etre fait par un automate : un sed naif
# laissait passer les commentaires de bloc, et comme ceux d app.js parlent
# justement de prompt(), le hook refusait tous les commits pour rien.
if [ -f app.js ]; then
  nu=$(awk '
    BEGIN{ inb=0 }
    {
      line=$0; out=""
      while(length(line)>0){
        if(inb){
          i=index(line,"*/")
          if(i==0){ line="" } else { line=substr(line,i+2); inb=0 }
        } else {
          i=index(line,"/*")
          if(i==0){ out=out line; line="" }
          else { out=out substr(line,1,i-1); line=substr(line,i+2); inb=1 }
        }
      }
      sub(/\/\/.*$/,"",out)
      print out
    }' app.js)
  for f in prompt confirm alert; do
    n=$(printf '%s' "$nu" | grep -oE "(^|[^A-Za-z0-9_.])$f[[:space:]]*\(" | wc -l | tr -d ' ')
    if [ "$n" != "0" ]; then
      echo "ERREUR : $n appel(s) a $f() natif dans app.js — invisible dans une PWA iOS."
      echo "         Utiliser customPrompt / customConfirm / toast."
      fail=1
    fi
  done
fi

# --- 4. Rappel de version ---------------------------------------------------
# Sans bump, les utilisateurs gardent l ancien fichier en cache.
if git diff --cached --name-only | grep -q '^app\.js$'; then
  git diff --cached --name-only | grep -q '^index\.html$' \
    || echo "ATTENTION : app.js modifie sans bump de app.js?v=N dans index.html"
fi

# --- 5. Rappel des suites ---------------------------------------------------
if git diff --cached --name-only | grep -qE '^(app\.js|index\.html|sw\.js)$'; then
  echo "Pense a rejouer :"
  echo "  - la suite de fumee   ouvrir l app avec ?selftest=1"
  echo "  - les tests securite  tests/security.sql dans le SQL Editor Supabase"
fi

[ "$fail" -eq 0 ] || { echo ""; echo "Commit refuse. Corrige les erreurs ci-dessus."; exit 1; }
exit 0
