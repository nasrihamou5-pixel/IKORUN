# ---------------------------------------------------------------------------
# EARLY HINTS DÉSACTIVÉS (V3.14.0)
#
# Cloudflare Pages fabrique tout seul un en-tête « Link » (Early Hints 103) à partir
# des <link rel=preload> d'index.html et le garde en cache à la périphérie : les
# téléphones recevaient des indices périmés (app.js?v=130, app.css?v=37) alors que la
# page demandait v=133/v=40 — deux téléchargements. Et une fois le service worker
# installé, Chrome jette ces préchargements faits « hors service worker »
# (« cross-world service worker resource mismatch ») et télécharge une deuxième fois.
# « ! Link » retire l'en-tête : les preload d'index.html, servis par le service
# worker, restent la SEULE liste des fichiers à précharger (aucun numéro à recopier ici).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# MISE EN CACHE
#
# index.html et manifest.json gardent le defaut de Cloudflare Pages
# (max-age=0, must-revalidate) : c'est index.html qui porte le numero de version
# de app.js, il doit donc toujours etre frais.
#
# /!\ REGLE A RESPECTER A CHAQUE DEPLOIEMENT : app.js est desormais servi comme
# immuable pendant un an. Le navigateur ne le redemandera JAMAIS pour une meme
# URL. Il faut donc imperativement incrementer le ?v=NN dans index.html
# (<script src="app.js?v=61">) a chaque modification de app.js, sinon tes
# utilisateurs resteront bloques sur l'ancienne version.
# ---------------------------------------------------------------------------

/app.js
  Cache-Control: public, max-age=31536000, immutable

# V3.14.0 : la page charge les versions minifiées (tools/build.mjs), même règle de version.
/app.min.js
  Cache-Control: public, max-age=31536000, immutable

/app.min.css
  Cache-Control: public, max-age=31536000, immutable

# V4.0.0 : modules chargés à la demande (même règle : monter leur ?v= dans window.IK_MOD).
/weather/*.min.js
  Cache-Control: public, max-age=31536000, immutable

# Feuille de style (sortie d'index.html le 28/09) : même règle, monter app.css?v=N.
/app.css
  Cache-Control: public, max-age=31536000, immutable

/vendor/supabase.js
  Cache-Control: public, max-age=31536000, immutable

# Initialisation Supabase (sortie d'index.html le 25/09) : même règle que app.js,
# monter le ?v= dans index.html (et sw.js SHELL) à chaque modification.
/vendor/sb-init.js
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000

/*.ico
  Cache-Control: public, max-age=2592000

# Polices hébergées (27/09) : le nom de fichier change si la police change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Le service worker doit rester revalide a chaque chargement, sinon une mise a
# jour de la strategie de cache ne peut plus jamais atteindre les appareils.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
