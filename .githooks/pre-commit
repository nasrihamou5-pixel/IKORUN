#!/bin/sh
# ============================================================================
# IKORUN — garde-fou de commit
#
# Installation (une fois) :   git config core.hooksPath .githooks
# Ce fichier est la reference ; .githooks/pre-commit en est la copie active.
#
# Deux des trois failles critiques de l'audit du 07/09/2026 auraient ete
# attrapees ici. La plus couteuse : une variable supprimee sans ses usages,
# ReferenceError en production pendant une heure, toutes les seances muscu
# cassees.
#
# Sans Node, les verifications de syntaxe et d'i18n sont IMPOSSIBLES. Le hook
# le dit desormais franchement au lieu de passer en silence : un garde-fou
# muet qui ne verifie rien est pire que pas de garde-fou, on lui fait
# confiance a tort.
# ============================================================================
fail=0
node_absent=0

command -v node >/dev/null 2>&1 || node_absent=1

if [ "$node_absent" -eq 1 ]; then
  echo "----------------------------------------------------------------"
  echo " ATTENTION : Node.js absent."
  echo " La syntaxe de app.js/sw.js et la coherence des traductions"
  echo " NE SONT PAS verifiees. Ce commit part sans filet."
  echo " Installer Node : https://nodejs.org  (choix LTS)"
  echo "----------------------------------------------------------------"
fi

# --- 1. Syntaxe -------------------------------------------------------------
if [ "$node_absent" -eq 0 ]; then
  # (V3.15.0) toutes les sources assemblées (tools/bundle.json), pas seulement app.js
  for f in sw.js tests/smoke.js $(node -e 'const b=require("./tools/bundle.json");console.log([...new Set(Object.entries(b).filter(([k])=>k.endsWith(".js")).flatMap(([,v])=>v))].join(" "))'); do
    [ -f "$f" ] || continue
    node --check "$f" || { echo "ERREUR de syntaxe dans $f"; fail=1; }
  done
fi

# --- 2. Coherence des traductions ------------------------------------------
if [ "$node_absent" -eq 0 ] && [ -f app.js ]; then
  node -e '
    const src=require("fs").readFileSync("app.js","utf8");
    const m=src.match(/const I18N *= *\{[\s\S]*?\n\};/);
    // Un controle qui abandonne en silence est pire que pas de controle : on
    // lui fait confiance a tort. Ici, ne pas pouvoir verifier EST une erreur.
    if(!m){ console.log("ERREUR i18n : bloc I18N introuvable dans app.js"); process.exit(1); }
    // Le bloc capture se termine par "};" — le point-virgule doit sauter, sinon
    // eval("({...};)") est une erreur de syntaxe et le controle passait a vide.
    const brut=m[0].replace(/^const I18N *= */,"").replace(/;\s*$/,"");
    let I18N; try{ I18N=eval("("+brut+")"); }catch(e){ console.log("ERREUR i18n : bloc non evaluable -",e.message); process.exit(1); }
    const fr=Object.keys(I18N.fr||{});
    const manqEn=fr.filter(k=>!(k in (I18N.en||{})));
    const manqAr=fr.filter(k=>!(k in (I18N.ar||{})));
    if(manqEn.length||manqAr.length){
      console.log("ERREUR i18n - manquantes en EN:", manqEn.join(", ")||"(aucune)");
      console.log("ERREUR i18n - manquantes en AR:", manqAr.join(", ")||"(aucune)");
      process.exit(1);
    }
    console.log("i18n OK ("+fr.length+" cles x 3 langues)");
  ' || fail=1
fi

# --- 3. Boites de dialogue natives -----------------------------------------
# prompt(), confirm() et alert() ne s ouvrent PAS dans une PWA installee sur
# iOS. Quatre appels a prompt() y sont restes des mois : "creer un plan perso"
# et "modifier la bio" ne faisaient simplement rien sur iPhone.
# Ne necessite pas Node.
#
# Le retrait des commentaires doit etre fait par un automate : un sed naif
# laissait passer les commentaires de bloc, et comme ceux d app.js parlent
# justement de prompt(), le hook refusait tous les commits pour rien.
JSSRC=$(grep -oE '"[A-Za-z0-9_/-]+\.js"' tools/bundle.json 2>/dev/null | tr -d '"' | grep -v '\.min\.js$' | sort -u)
[ -n "$JSSRC" ] || JSSRC=app.js
if [ -f app.js ]; then
  nu=$(cat $JSSRC | awk '
    BEGIN{ inb=0 }
    {
      line=$0; out=""
      while(length(line)>0){
        if(inb){
          i=index(line,"*/")
          if(i==0){ line="" } else { line=substr(line,i+2); inb=0 }
        } else {
          i=index(line,"/*")
          if(i==0){ out=out line; line="" }
          else { out=out substr(line,1,i-1); line=substr(line,i+2); inb=1 }
        }
      }
      sub(/\/\/.*$/,"",out)
      print out
    }')
  for f in prompt confirm alert; do
    n=$(printf '%s' "$nu" | grep -oE "(^|[^A-Za-z0-9_.])$f[[:space:]]*\(" | wc -l | tr -d ' ')
    if [ "$n" != "0" ]; then
      echo "ERREUR : $n appel(s) a $f() natif dans les sources JS — invisible dans une PWA iOS."
      echo "         Utiliser customPrompt / customConfirm / toast."
      fail=1
    fi
  done
fi

# --- 4. Rappel de version ---------------------------------------------------
# Sans bump, les utilisateurs gardent l ancien fichier en cache.
if git diff --cached --name-only | grep -q '^app\.js$'; then
  git diff --cached --name-only | grep -q '^index\.html$' \
    || echo "ATTENTION : app.js modifie sans bump de app.js?v=N dans index.html"
fi

# --- 4a. Feuille de style ----------------------------------------------------
# app.css est servi « immutable » un an (voir _headers) : modifie sans monter
# app.css?v=N dans index.html, les telephones garderaient l ancienne version.
if git diff --cached --name-only | grep -q '^app\.css$'; then
  git diff --cached -U0 -- index.html | grep -qE '^\+.*app(\.min)?\.css\?v=' || {
    echo "ERREUR : app.css modifie sans monter app.css?v=N dans index.html"; fail=1; }
fi

# --- 4b. Numero de version affiche -----------------------------------------
# APP_VERSION (app.js) est le numero que voit l utilisateur (V3.2.0). Toute nouvelle
# version d app.js (?v=N change dans index.html) doit le faire evoluer.
# (V3.14.0) on compare le NUMÉRO ?v=N : renommer app.js en app.min.js sans changer N ne compte pas.
oldv=$(git show HEAD:index.html 2>/dev/null | grep -oE 'app(\.min)?\.js\?v=[0-9]+' | head -1 | grep -oE '[0-9]+$')
newv=$(git show :index.html 2>/dev/null | grep -oE 'app(\.min)?\.js\?v=[0-9]+' | head -1 | grep -oE '[0-9]+$')
if [ -n "$newv" ] && [ "$oldv" != "$newv" ]; then
  old=$(git show HEAD:app.js 2>/dev/null | grep -o "const APP_VERSION='[^']*'" | head -1)
  new=$(git show :app.js 2>/dev/null | grep -o "const APP_VERSION='[^']*'" | head -1)
  if [ -z "$new" ]; then
    echo "ERREUR : APP_VERSION introuvable dans app.js"; fail=1
  elif [ -n "$old" ] && [ "$old" = "$new" ]; then
    echo "ERREUR : nouvelle version d app.js (?v=) mais $new n a pas change."
    echo "         Correctif : dernier chiffre +1 (3.2.0 -> 3.2.1) ; nouveautes : 3.2.x -> 3.3.0"
    fail=1
  fi
fi

# --- 4c. Versions qui ne peuvent plus diverger (V3.14.0) -----------------------
# Un meme fichier cite avec deux ?v= differents dans index.html = deux telechargements
# (le preload d une version, l execution d une autre). Et une page qui change ses
# ?v= sans nouveau cache du service worker (const C) garderait l ancienne coquille.
if [ -f index.html ]; then
  for f in $(git show :index.html 2>/dev/null | grep -oE "[A-Za-z0-9_/.-]+\.(js|css)\?v=" | sed 's/?v=$//' | sort -u | sed 's/\./\\./g'); do
    nv=$(git show :index.html 2>/dev/null | grep -oE "$f\?v=[0-9]+" | sort -u | wc -l | tr -d ' ')
    if [ "$nv" -gt 1 ]; then
      echo "ERREUR : index.html cite $(echo $f | tr -d '\\') avec $nv numeros ?v= differents :"
      git show :index.html | grep -oE "$f\?v=[0-9]+" | sort -u | sed 's/^/           /'
      fail=1
    fi
  done
  if git diff --cached -U0 -- index.html | grep -qE '^\+.*\.(js|css)\?v='; then
    git diff --cached -U0 -- sw.js | grep -qE "^\+const C *=" || {
      echo "ERREUR : les ?v= d index.html ont change mais pas const C dans sw.js"; fail=1; }
  fi
  if git show :_headers 2>/dev/null | grep -qE '^[^#]*\?v=[0-9]'; then
    echo "ERREUR : _headers cite un fichier versionne (?v=N) : il serait perime a la prochaine version"; fail=1
  fi
fi

# --- 4d. Fichiers servis a jour (V3.14.0, V3.15.0 : plusieurs sources) -------
# La page charge des fichiers assembles et minifies (tools/build.mjs, d apres
# tools/bundle.json). Leur en-tete porte l empreinte des sources assemblees :
# une source modifiee sans reconstruction = refus.
# 4e. Un fichier servi qui change doit changer de ?v= dans index.html (sinon les
# telephones gardent l ancien, servi « immutable »).
if [ "$node_absent" -eq 0 ] && [ -f tools/bundle.json ]; then
  node -e '
    const {execSync}=require("child_process"), crypto=require("crypto");
    const show=f=>{ try{ return execSync("git show :"+f,{encoding:"utf8",maxBuffer:1<<28}); }catch(e){ return null; } };
    const showHead=f=>{ try{ return execSync("git show HEAD:"+f,{encoding:"utf8",maxBuffer:1<<28,stdio:["pipe","pipe","ignore"]}); }catch(e){ return null; } };
    const b=JSON.parse(show("tools/bundle.json")); let bad=0;
    const staged=execSync("git diff --cached --name-only",{encoding:"utf8"}).split("\n");
    const idx=show("index.html")||"", idxHead=showHead("index.html")||"";
    const vOf=(html,f)=>{ const m=html.match(new RegExp(f.replace(/[.\/]/g,"\\$&")+"\\?v=(\\d+)")); return m?m[1]:null; };
    for(const [out,srcs] of Object.entries(b)){ if(out==="_") continue;
      const parts=srcs.map(show); if(parts.some(x=>x===null)){ console.log("ERREUR : source absente de l index pour "+out+" : "+srcs.filter((s,i)=>parts[i]===null).join(", ")); bad=1; continue; }
      const want=crypto.createHash("sha256").update(parts.join("\n")).digest("hex").slice(0,16);
      const o=show(out); const have=o&&((o.slice(0,600).match(/sha:([0-9a-f]+)/)||[])[1]);
      if(want!==have){ console.log("ERREUR : "+out+" ne correspond pas a ses sources ("+srcs.join(" + ")+") : lancer node tools/build.mjs, puis git add "+out); bad=1; }
      if(staged.includes(out) && showHead(out)!==null){
        const a=vOf(idxHead,out), n=vOf(idx,out);
        if(!n) { console.log("ERREUR : "+out+" n est cite nulle part dans index.html avec un ?v=N"); bad=1; }
        else if(a===n){ console.log("ERREUR : "+out+" a change mais son ?v="+n+" est le meme dans index.html"); bad=1; }
      }
    }
    process.exit(bad);
  ' || fail=1
fi

# --- 5. Rappel des suites ---------------------------------------------------
if git diff --cached --name-only | grep -qE '^(app\.js|index\.html|sw\.js)$'; then
  echo "Pense a rejouer :"
  echo "  - la suite de fumee   ouvrir l app avec ?selftest=1"
  echo "  - les tests securite  tests/security.sql dans le SQL Editor Supabase"
fi

[ "$fail" -eq 0 ] || { echo ""; echo "Commit refuse. Corrige les erreurs ci-dessus."; exit 1; }
exit 0
